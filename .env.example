# Postgres (matches docker-compose.yml defaults for local dev)
DATABASE_URL="postgresql://antflow:antflow@localhost:55432/antflow_sales_os"

# Claude (Anthropic) - powers the AI Employee Runtime (src/lib/ai-runtime.ts)
ANTHROPIC_API_KEY=""
# Optional override - defaults to claude-opus-5 if unset
ANTHROPIC_MODEL=""

# WhatsApp Cloud API - required once the channel gateway is wired up
WHATSAPP_ACCESS_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_WEBHOOK_VERIFY_TOKEN=""
# App secret from the Meta App dashboard - used to verify X-Hub-Signature-256
# on incoming webhook POSTs so we don't process spoofed requests.
WHATSAPP_APP_SECRET=""

# Object storage (Cloudflare R2 or S3-compatible) - for receipt images (src/lib/media-storage.ts).
# All four must be set together to activate it; if any is missing, receipts are
# saved to local disk (storage/receipts/, gitignored) instead - fine for local
# dev, not for production.
STORAGE_ENDPOINT=""
STORAGE_BUCKET=""
STORAGE_ACCESS_KEY_ID=""
STORAGE_SECRET_ACCESS_KEY=""
# Public base URL for the bucket (R2 public bucket URL or custom domain) - receipt
# links are built as `${STORAGE_PUBLIC_BASE_URL}/receipts/<file>`.
STORAGE_PUBLIC_BASE_URL=""

# Dashboard auth (src/lib/auth.ts) - signs session cookies for /settings, /dashboard, /manage.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=""

# Encrypts each business's stored WhatsApp access token at rest
# (BusinessMetaConnection.encryptedAccessToken, src/lib/credential-crypto.ts) -
# written by the Connect WhatsApp wizard (src/app/settings/whatsapp). Must be
# a 32-byte key, hex-encoded. Generate the same way as AUTH_SECRET:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# A business with no BusinessMetaConnection row yet still works - credentials
# fall back to the WHATSAPP_ACCESS_TOKEN/META_* vars below either way.
CREDENTIAL_ENCRYPTION_KEY=""

# Connect WhatsApp wizard (src/app/settings/whatsapp) - Meta's Embedded
# Signup, for any business to self-serve connect their own WhatsApp
# Business Account through this app's own UI instead of Meta Business
# Suite. Both come from the platform's own Meta App (Meta for Developers ->
# this app -> WhatsApp -> Embedded Signup), a one-time manual setup step -
# see docs/META_CONVERSIONS_SETUP.md. NEXT_PUBLIC_ because the JS SDK on
# the client needs the App ID and config_id directly; nothing secret lives
# in either of these two (the actual secret is WHATSAPP_APP_SECRET above,
# used only server-side for the OAuth code exchange).
NEXT_PUBLIC_META_APP_ID=""
NEXT_PUBLIC_META_EMBEDDED_SIGNUP_CONFIG_ID=""
