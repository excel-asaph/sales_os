# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# prisma generated client (regenerate with `npx prisma generate`)
/src/generated

# locally-persisted receipt images (media-storage.ts) — a stand-in for real
# object storage (S3/R2), not meant to be committed
/storage

# Source material dropped in for analysis, not part of the app — ad video
# creatives and their copy. Measured findings live in
# docs/GROWTH_OS_STRATEGY.md §13b instead; the media itself is ~170MB and has
# no business in git history.
/Diabetes Fix  Ads/
