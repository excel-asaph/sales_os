// Antflow Sales OS — Prisma schema
// Mirrors docs/ARCHITECTURE.md §5 (Database Schema). Keep the two in sync:
// if a field or table changes here, update the architecture doc, and vice versa.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Workflow state (PRD Chapter 5.4)
// ---------------------------------------------------------------------------

enum ConversationStage {
  NEW_LEAD
  GREETING_SENT
  INTRODUCTION_COMPLETED
  INTEREST_CONFIRMED
  PRODUCT_SELECTED
  WAITING_FOR_DECISION
  WAITING_FOR_PAYMENT
  RECEIPT_RECEIVED
  PAYMENT_VERIFIED
  PRODUCT_DELIVERED
  SALE_COMPLETED
  FOLLOWUP_DAY_1
  FOLLOWUP_DAY_3
  FOLLOWUP_DAY_7
  LOST_LEAD
  HUMAN_REVIEW_REQUIRED
  HUMAN_ASSIGNED
  RESOLVED
}

enum MessageDirection {
  INBOUND
  OUTBOUND
}

enum MessageSender {
  CUSTOMER
  AI
  HUMAN
}

enum MessageType {
  TEXT
  IMAGE
  DOCUMENT
  VOICE
}

// Conversation Brain facts (PRD Chapter 6.3): intent, goals, objections,
// extracted entities, and outstanding tasks all live here as typed rows
// rather than one JSON blob, so "which objections are unresolved" stays
// a real query.
enum FactKind {
  INTENT
  GOAL
  OBJECTION
  ENTITY
  TASK
}

enum OrderStatus {
  PENDING
  VERIFIED
  ESCALATED
  REJECTED
}

/// What a follow-up sequence is actually waiting on — decides what happens
/// if the customer never responds and the sequence exhausts (src/worker/
/// followup-worker.ts): GENERAL ends in LOST_LEAD as before, but
/// AWAITING_PAYMENT_EVIDENCE means the customer already claimed to have
/// paid, so silence isn't necessarily disinterest — it escalates to a
/// human instead of getting quietly tagged "Uninterested".
enum FollowupReason {
  GENERAL
  AWAITING_PAYMENT_EVIDENCE
}

/// A person's role inside one workspace (v2, docs/V2_BUILD_PLAN.md).
/// OWNER and ADMIN can reach /settings and /manage, as isAdmin did; only an
/// OWNER can remove other owners or close the workspace. AGENT is the old
/// non-admin login.
enum MemberRole {
  OWNER
  ADMIN
  AGENT
}

enum ChannelStatus {
  /// Receiving and sending.
  ACTIVE
  /// Kept for history (its conversations still point at it) but no longer
  /// matched for inbound messages or used for sending.
  DISCONNECTED
}

// ---------------------------------------------------------------------------
// People (v2)
// ---------------------------------------------------------------------------

/// One person, across every workspace they belong to. v1 had no such thing:
/// a HumanAgent row was both the person and their place in one business, so
/// someone working for two businesses needed two logins. In v2 HumanAgent
/// becomes the membership (userId + role) and this holds the login.
///
/// Added alongside HumanAgent's own contact/passwordHash rather than
/// replacing them, so v1's login keeps working until switch-over and can be
/// rolled back to (docs/V2_BUILD_PLAN.md, "add first, remove last").
model User {
  id              String    @id @default(cuid())
  /// Always stored lowercased, so login is case-insensitive without a
  /// functional index.
  email           String    @unique
  name            String
  /// Null for someone who only ever signs in with Google.
  passwordHash    String?   @map("password_hash")
  googleId        String?   @unique @map("google_id")
  emailVerifiedAt DateTime? @map("email_verified_at")
  /// Antflow staff: can open any workspace for support. Every action taken
  /// inside a workspace that isn't their own is written to the event log.
  isPlatformAdmin Boolean   @default(false) @map("is_platform_admin")
  createdAt       DateTime  @default(now()) @map("created_at")

  memberships HumanAgent[]

  @@map("users")
}

// ---------------------------------------------------------------------------
// Business
// ---------------------------------------------------------------------------

model Business {
  id                    String   @id @default(cuid())
  name                  String
  whatsappPhoneNumberId String?  @map("whatsapp_phone_number_id")
  /// Extra WhatsApp Cloud API phone_number_ids beyond the primary one above
  /// — same business, same AI/catalog/team, just additional lines customers
  /// can reach it on (Meta allows up to 2 numbers per WABA pre-verification,
  /// 20 after). ingest-message.ts matches an inbound webhook's
  /// phone_number_id against the primary field OR this list.
  additionalWhatsappPhoneNumberIds String[] @default([]) @map("additional_whatsapp_phone_number_ids")
  /// Maps a phone_number_id (primary or additional, above) to a
  /// human-readable label (e.g. "+234 810 573 4894") for display in the
  /// dashboard's number switcher — Meta's ids alone aren't meaningful to a
  /// business owner. Json rather than a join table since it's small,
  /// read-only-in-practice reference data, same rationale as
  /// Conversation.referral.
  whatsappPhoneNumberLabels Json? @map("whatsapp_phone_number_labels")
  timezone              String   @default("Africa/Lagos")
  createdAt             DateTime @default(now()) @map("created_at")

  config          BusinessConfig?
  metaConnection  BusinessMetaConnection?
  paymentAccounts PaymentAccount[]
  products        Product[]
  customers       Customer[]
  humanAgents     HumanAgent[]
  faqEntries      FaqEntry[]
  channels        Channel[]
  adProducts      AdProduct[]

  @@map("businesses")
}

/// Per-business Meta/WhatsApp connection, written by the Embedded Signup
/// onboarding wizard (src/app/settings/whatsapp). Before this existed, every
/// credential here (WHATSAPP_ACCESS_TOKEN, META_CONVERSIONS_DATASET_ID,
/// META_WHATSAPP_BUSINESS_ACCOUNT_ID) was a single deployment-wide env var —
/// fine for one business, not for a real multi-tenant platform. A business
/// with no row here still works: src/lib/meta-credentials.ts falls back to
/// those same env vars, which is what keeps local dev and any
/// not-yet-migrated business working without a schema-breaking cutover.
///
/// WHATSAPP_APP_SECRET and WHATSAPP_WEBHOOK_VERIFY_TOKEN deliberately do NOT
/// move here — those belong to the platform's own Meta App (the one webhook
/// endpoint every connected business's messages arrive on, disambiguated by
/// phone_number_id in ingest-message.ts), not to an individual business.
model BusinessMetaConnection {
  id          String @id @default(cuid())
  businessId  String @unique @map("business_id")
  wabaId      String @map("waba_id")
  /// AES-256-GCM, base64(iv + authTag + ciphertext) — see
  /// src/lib/credential-crypto.ts. The only encrypted-at-rest field in this
  /// schema; everything else here is an identifier, not a secret.
  encryptedAccessToken String @map("encrypted_access_token")
  conversionsDatasetId String? @map("conversions_dataset_id")
  followupTemplateName String? @map("followup_template_name")
  followupTemplateLang String? @map("followup_template_lang")
  /// NOT_STARTED | PENDING | VERIFIED | REJECTED — Meta's own verification
  /// review status, mirrored here so the wizard/settings page can show it
  /// without a live API call on every page load.
  businessVerificationStatus String @default("NOT_STARTED") @map("business_verification_status")
  connectedAt    DateTime  @default(now()) @map("connected_at")
  /// Last time a real Graph API call using this token succeeded — distinct
  /// from connectedAt, which never changes after the initial signup.
  lastVerifiedAt DateTime? @map("last_verified_at")

  // v2: each business brings its own Meta App (docs/V2_REVAMP.md,
  // "Connecting WhatsApp without becoming a Tech Provider"), which reverses
  // the note above for these three — the app secret and verify token now
  // belong to the business, not the platform. Null until the business is
  // moved onto its own webhook; until then it is served by the shared
  // /api/whatsapp endpoint and the env-var secret, exactly as in v1.
  metaAppId                   String? @map("meta_app_id")
  /// Encrypted the same way as encryptedAccessToken. Checks the
  /// X-Hub-Signature-256 header on this business's webhook.
  encryptedAppSecret          String? @map("encrypted_app_secret")
  /// Encrypted. What Meta sends back when the webhook address is first
  /// saved in the business's Meta App.
  encryptedWebhookVerifyToken String? @map("encrypted_webhook_verify_token")
  /// Random, unguessable, and the only thing in the business's webhook
  /// address (/api/whatsapp/<webhookKey>), so the address says which secret
  /// to check a message against without revealing the business's id.
  webhookKey                  String? @unique @map("webhook_key")

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@map("business_meta_connections")
}

/// One WhatsApp number a business can be reached on (v2). Replaces
/// Business.whatsappPhoneNumberId, .additionalWhatsappPhoneNumberIds and
/// .whatsappPhoneNumberLabels: three fields doing one table's job. Those
/// stay, unread once v2 switches over, until the clean-up migration.
model Channel {
  id            String        @id @default(cuid())
  businessId    String        @map("business_id")
  /// Meta's phone_number_id. Unique across the platform: an inbound
  /// webhook names only this, and it has to resolve to exactly one
  /// business.
  phoneNumberId String        @unique @map("phone_number_id")
  /// The number as people read it, e.g. "+234 810 573 4894".
  displayNumber String?       @map("display_number")
  /// The business's own name for it, e.g. "Diabetes ads line".
  label         String?
  status        ChannelStatus @default(ACTIVE)
  createdAt     DateTime      @default(now()) @map("created_at")

  business      Business         @relation(fields: [businessId], references: [id], onDelete: Cascade)
  products      ChannelProduct[]
  conversations Conversation[]

  @@index([businessId])
  @@map("channels")
}

/// Which products a number sells. One row means a dedicated number, so
/// every conversation on it is about that product; several means a shared
/// number, where the ad, the opening message or the AI decides
/// (docs/V2_REVAMP.md, "One number, several products").
model ChannelProduct {
  channelId String @map("channel_id")
  productId String @map("product_id")

  channel Channel @relation(fields: [channelId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@id([channelId, productId])
  @@map("channel_products")
}

/// Business Rules Engine (PRD 5.10, Module 6) — every business-specific
/// policy lives here, never hardcoded in application code (Non-Negotiable 14.4).
model BusinessConfig {
  id                          String   @id @default(cuid())
  businessId                  String   @unique @map("business_id")
  deliverBeforePayment        Boolean  @default(false) @map("deliver_before_payment")
  /// How many steps of the fixed follow-up sequence (src/lib/followup-sequence.ts)
  /// to run before giving up and auto-tagging the customer "Uninterested".
  /// Business-editable (Settings → General); 5 is the full designed
  /// sequence, so this is clamped 1-5 in the UI and worker.
  maxFollowups                Int      @default(5) @map("max_followups")
  escalationConfidenceThreshold Float  @default(0.7) @map("escalation_confidence_threshold")
  /// When a receipt fails automated verification for a correctable reason
  /// (wrong amount, wrong account, unreadable image), let the AI tell the
  /// customer specifically what's wrong and ask them to resend, instead of
  /// escalating to a human on the first mismatch. Capped at
  /// RECEIPT_RETRY_LIMIT (src/lib/actions.ts) regardless of this setting —
  /// and never applies to a receipt that looks digitally altered, or any
  /// non-payment escalation (refunds, complaints, anger) — those always
  /// reach a human.
  aiHandlesReceiptIssues       Boolean  @default(true) @map("ai_handles_receipt_issues")
  /// Business-wide kill switch for the Follow-Up Engine. When false, the
  /// worker (BLOCKS_FOLLOWUP check) cancels anything already scheduled and
  /// createFollowup (src/lib/actions.ts) refuses to start new sequences —
  /// so nothing accumulates that would need cancelling again on resume.
  /// Settings → General. No "catch up on resume": pausing cancels pending
  /// follow-ups outright rather than deferring them, deliberately, to
  /// avoid a stale nudge arriving days late.
  followupsEnabled             Boolean  @default(true) @map("followups_enabled")
  /// Whether the AI may answer from the product's own text (Product.contentText)
  /// once a conversation has reached delivery. Settings → General.
  ///
  /// Separate from whether the text exists: loading it is a rare, technical
  /// job (scripts/set-product-text.ts) but switching it off is a decision a
  /// business owner might make on any afternoon, and that should not need a
  /// terminal and a production database URL. Same split as followupsEnabled,
  /// where the engine exists regardless and this decides whether it runs.
  ///
  /// Defaults true so the migration changes nothing for a business that has
  /// already loaded its text.
  productContentEnabled       Boolean  @default(true) @map("product_content_enabled")
  businessHours               Json?    @map("business_hours")
  greetingTemplate            String?  @map("greeting_template")
  /// Sales Playbook (PRD 11.3, Knowledge Engine) — this business's own
  /// proven scripts (trust-building lines, payment sign-off, confirmation
  /// phrase, follow-up wording). A flexible string map rather than fixed
  /// columns because the set of scripts worth capturing differs per
  /// business. The AI is instructed to mirror these closely, not to
  /// freehand-compose new copy (Non-Negotiable/Philosophy: consistency
  /// builds trust).
  playbook                     Json?

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@map("business_config")
}

/// Curated FAQ (PRD Ch 11, Knowledge Engine) — business-owner-authored Q&A
/// pairs, injected into the system prompt verbatim so the AI answers common
/// product questions consistently instead of improvising from the ebook.
/// Full-document search over the ebook itself is a deferred phase 2
/// (docs/FUTURE.md) — only worth building once real customers ask things
/// this curated list can't cover.
model FaqEntry {
  id         String   @id @default(cuid())
  businessId String   @map("business_id")
  /// v2: set for a question about one product only. Null means it applies
  /// to every product, which is every v1 entry.
  productId  String?  @map("product_id")
  question   String
  answer     String
  order      Int      @default(0)
  createdAt  DateTime @default(now()) @map("created_at")

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  product  Product? @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@map("faq_entries")
}

/// Payment Knowledge (PRD 11.3)
model PaymentAccount {
  id            String  @id @default(cuid())
  businessId    String  @map("business_id")
  bankName      String  @map("bank_name")
  accountNumber String  @map("account_number")
  accountName   String  @map("account_name")
  active        Boolean @default(true)

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  orders   Order[]

  @@map("payment_accounts")
}

/// Product Knowledge (PRD 11.3)
model Product {
  id          String  @id @default(cuid())
  businessId  String  @map("business_id")
  name        String
  description String?
  price       Decimal
  currency    String  @default("NGN")
  fileUrl     String? @map("file_url")
  /// The product's own text, extracted once from fileUrl and stored here so
  /// the AI can answer "what does the book actually say" without a retrieval
  /// layer (scripts/extract-product-text.ts). Only injected into the system
  /// prompt from PRODUCT_DELIVERED onward — see src/lib/system-prompt.ts —
  /// because before delivery a content question is a sales objection, and
  /// after it the customer owns the thing and is asking for support.
  /// Null is the normal state: a business without this behaves exactly as
  /// it did before the field existed.
  contentText String? @map("content_text")
  format      String?
  category    String?
  available   Boolean @default(true)
  /// v2: the message this product's WhatsApp link fills in for the customer,
  /// e.g. "Hi, I want the Fat-Burning Switch". A first message containing it
  /// starts the conversation on this product, which is how one number can
  /// sell several products (src/lib/product-routing.ts).
  whatsappOpeningText String? @map("whatsapp_opening_text")

  business      Business         @relation(fields: [businessId], references: [id], onDelete: Cascade)
  orders        Order[]
  channels      ChannelProduct[]
  conversations Conversation[]
  settings      ProductSettings?
  faqEntries    FaqEntry[]
  ads           AdProduct[]

  @@map("products")
}

/// v2: which product a Click-to-WhatsApp ad sells, set by the business on
/// the Products page. Meta names the ad (referral.source_id) on the first
/// message from it, which is the most reliable way to know what a customer
/// on a shared number came for (src/lib/product-routing.ts).
model AdProduct {
  id         String   @id @default(cuid())
  businessId String   @map("business_id")
  /// Meta's ad id, as sent in the webhook's referral.source_id.
  adId       String   @map("ad_id")
  productId  String   @map("product_id")
  createdAt  DateTime @default(now()) @map("created_at")

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  product  Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([businessId, adId])
  @@map("ad_products")
}

/// v2: one product's own sales settings (docs/V2_BUILD_PLAN.md, Phase 2).
/// Every field is optional, and an empty one uses the business's
/// BusinessConfig value, so a product with no row here, or an empty row,
/// sells exactly as the business does. The merge lives in one place,
/// getEffectiveConfig in src/lib/knowledge.ts; nothing else should read
/// these fields directly.
///
/// Tone of voice and bank accounts are deliberately business-wide (owner's
/// decision, 2026-10-03).
model ProductSettings {
  id        String @id @default(cuid())
  productId String @unique @map("product_id")
  /// Overrides the business playbook script by script: a key set here
  /// replaces that one script, and every other script still comes from the
  /// business. Its pitch scripts (payment_first_pitch, delivery_first_pitch)
  /// are the product's own opening message.
  playbook               Json?
  deliverBeforePayment   Boolean? @map("deliver_before_payment")
  /// Can only switch this product's follow-ups off. The business's own
  /// switch is a pause on everything and always wins.
  followupsEnabled       Boolean? @map("followups_enabled")
  maxFollowups           Int?     @map("max_followups")
  aiHandlesReceiptIssues Boolean? @map("ai_handles_receipt_issues")
  productContentEnabled  Boolean? @map("product_content_enabled")
  updatedAt              DateTime @updatedAt @map("updated_at")

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@map("product_settings")
}

// ---------------------------------------------------------------------------
// Customer & conversation
// ---------------------------------------------------------------------------

/// Customer Profile (PRD 6.3)
model Customer {
  id                String   @id @default(cuid())
  businessId        String   @map("business_id")
  phoneNumber       String   @map("phone_number")
  name              String?
  preferredLanguage String?  @map("preferred_language")
  country           String?
  timezone          String?
  returningCustomer Boolean  @default(false) @map("returning_customer")
  lifetimePurchases Int      @default(0) @map("lifetime_purchases")
  customerSince     DateTime @default(now()) @map("customer_since")
  tags              Json?
  /// v2: a team member trying the AI from the test chat (/manage/test-chat,
  /// src/lib/test-chat.ts), not a real customer. Their phone number is
  /// "test-<member id>". Nothing is sent to WhatsApp, no follow-up is
  /// scheduled and no sale is reported to Meta for them, and every dashboard
  /// list, count and trend leaves them out.
  isTest            Boolean  @default(false) @map("is_test")

  business      Business       @relation(fields: [businessId], references: [id], onDelete: Cascade)
  conversations Conversation[]

  @@unique([businessId, phoneNumber])
  @@map("customers")
}

/// Conversation state (PRD 6.3) + Workflow Engine state (PRD 5.4)
model Conversation {
  id               String            @id @default(cuid())
  customerId       String            @map("customer_id")
  currentStage     ConversationStage @default(NEW_LEAD) @map("current_stage")
  currentObjective String?           @map("current_objective")
  confidence       Float?
  assignedHumanId  String?           @map("assigned_human_id")
  summary          String?
  /// Which of the business's WhatsApp numbers (Business.whatsappPhoneNumberId
  /// or .additionalWhatsappPhoneNumberIds) this conversation came in on — set
  /// once, from whichever number started it, same pattern as `referral`
  /// below. Every outbound reply in this thread goes out on this same
  /// number rather than switching, so the customer sees one consistent
  /// identity for the life of the conversation.
  whatsappPhoneNumberId String?      @map("whatsapp_phone_number_id")
  /// Ad/post attribution (Meta's `referral` webhook object) — set once,
  /// from whatever the *first* inbound message of this conversation
  /// carried. A flexible Json field (like BusinessConfig.playbook) rather
  /// than fixed columns since it's read-only reference data, not queried
  /// field-by-field.
  referral         Json?
  /// v2: the number this conversation is on, as a Channel. Supersedes
  /// whatsappPhoneNumberId above, which stays until the clean-up migration.
  channelId        String?           @map("channel_id")
  /// v2: the product this conversation is about. Set from the channel when
  /// it sells one product, otherwise from the ad or opening message, or by
  /// the AI once the customer says what they want. Null means not known yet.
  productId        String?           @map("product_id")
  createdAt        DateTime          @default(now()) @map("created_at")
  updatedAt        DateTime          @updatedAt @map("updated_at")

  customer     Customer          @relation(fields: [customerId], references: [id], onDelete: Cascade)
  assignedTo   HumanAgent?       @relation(fields: [assignedHumanId], references: [id])
  channel      Channel?          @relation(fields: [channelId], references: [id], onDelete: SetNull)
  product      Product?          @relation(fields: [productId], references: [id], onDelete: SetNull)
  messages     Message[]
  facts        ConversationFact[]
  orders       Order[]
  followups    Followup[]
  events       Event[]

  @@map("conversations")
}

model Message {
  id             String            @id @default(cuid())
  conversationId String            @map("conversation_id")
  direction      MessageDirection
  sender         MessageSender
  type           MessageType       @default(TEXT)
  content        String?
  mediaUrl       String?           @map("media_url")
  /// WhatsApp's own message id (wamid), inbound only — lets ingest-message.ts
  /// recognize a webhook redelivery of a message already processed instead
  /// of reprocessing it as new. Null for outbound messages, which have no
  /// wamid of their own at creation time.
  whatsappMessageId String?        @unique @map("whatsapp_message_id")
  createdAt      DateTime          @default(now()) @map("created_at")

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@map("messages")
}

/// Intent / Goals / Objections / Extracted Entities / Outstanding Tasks (PRD 6.3)
model ConversationFact {
  id             String       @id @default(cuid())
  conversationId String       @map("conversation_id")
  kind           FactKind
  payload        Json
  confidence     Float?
  resolved       Boolean      @default(false)
  createdAt      DateTime     @default(now()) @map("created_at")

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@map("conversation_facts")
}

/// Payment Collection + Receipt Verification (PRD 13.3)
model Order {
  id                      String          @id @default(cuid())
  conversationId          String          @map("conversation_id")
  productId               String          @map("product_id")
  paymentAccountId        String?         @map("payment_account_id")
  expectedAmount          Decimal         @map("expected_amount")
  receiptImageUrl         String?         @map("receipt_image_url")
  extractedAmount         Decimal?        @map("extracted_amount")
  extractedBank           String?         @map("extracted_bank")
  verificationConfidence  Float?          @map("verification_confidence")
  status                  OrderStatus     @default(PENDING)
  verifiedAt              DateTime?       @map("verified_at")
  createdAt               DateTime        @default(now()) @map("created_at")
  /// When this order's sale was successfully reported to Meta's Conversions
  /// API as a Purchase event (meta-conversions.ts) — null if it never
  /// succeeded (not yet attempted, not ad-attributed, or failed; see
  /// metaConversionReportReason for which).
  metaConversionReportedAt DateTime?      @map("meta_conversion_reported_at")
  /// The outcome of the most recent report attempt — "reported",
  /// "not_ad_attributed", "send_failed", or "not_configured" (see
  /// ConversionReportResult in meta-conversions.ts). Null means no attempt
  /// has ever run for this order (e.g. it predates this feature). Set on
  /// every attempt regardless of outcome, so the dashboard can show *why*
  /// a sale wasn't reported, not just whether it was.
  metaConversionReportReason String?      @map("meta_conversion_report_reason")

  conversation   Conversation    @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  product        Product         @relation(fields: [productId], references: [id])
  paymentAccount PaymentAccount? @relation(fields: [paymentAccountId], references: [id])

  @@map("orders")
}

/// Follow-Up Engine (PRD 8.6)
model Followup {
  id             String    @id @default(cuid())
  conversationId String    @map("conversation_id")
  step           Int
  /// The message the AI planned to send when scheduling this follow-up.
  /// Not sent verbatim — the worker re-enters the AI Employee Runtime with
  /// this as context so the actual wording stays natural (ARCHITECTURE.md
  /// §9); it's used as the fallback template if that generation fails.
  message        String
  reason         FollowupReason @default(GENERAL)
  /// When this step's countdown actually started (not when the row was
  /// written — the two are always the same in practice, but this is what
  /// the Customers list's live countdown bar measures elapsed time from).
  createdAt      DateTime  @default(now()) @map("created_at")
  scheduledFor   DateTime  @map("scheduled_for")
  sent           Boolean   @default(false)
  cancelled      Boolean   @default(false)

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@map("followups")
}

/// Human Handoff (PRD 5.9, 8.7) — also the Dashboard's login identity
/// (PRD 4: "a single admin/business-owner role and a human-agent role,
/// two roles only for MVP"). `isAdmin` distinguishes the two: an admin can
/// reach /settings and /manage, a plain agent only /dashboard.
model HumanAgent {
  id           String  @id @default(cuid())
  businessId   String  @map("business_id")
  name         String
  contact      String? // WhatsApp number or dashboard login identifier
  passwordHash String  @map("password_hash")
  isAdmin      Boolean @default(false) @map("is_admin")
  active       Boolean @default(true)
  /// v2: the person this membership belongs to, and their role in this
  /// business. Both null on a row the backfill (scripts/v2-backfill.ts)
  /// hasn't reached yet; such a row still logs in the v1 way via
  /// contact/passwordHash. `role` replaces isAdmin, which stays until the
  /// clean-up migration.
  userId       String?     @map("user_id")
  role         MemberRole?
  /// v2: Antflow staff (User.isPlatformAdmin) working inside a business
  /// they don't belong to, created when they open it from /admin
  /// (src/lib/support-access.ts). Gives them the same footing as an ADMIN,
  /// so taking over a chat or sending a message records who did it, but is
  /// left out of the business's own team list, its last-admin rule and the
  /// person's workspace switcher.
  support      Boolean     @default(false)

  business      Business       @relation(fields: [businessId], references: [id], onDelete: Cascade)
  user          User?          @relation(fields: [userId], references: [id], onDelete: Cascade)
  conversations Conversation[]

  // Login (src/app/login/actions.ts) looks agents up by contact with
  // findFirst, not findUnique — nothing previously stopped two agents in
  // the same business sharing a contact, which would make login pick
  // between them unpredictably. Multiple NULLs are still fine under
  // Postgres unique-constraint semantics (NULL is never equal to NULL).
  @@unique([businessId, contact])
  /// A person has at most one membership per business.
  @@unique([businessId, userId])
  @@map("human_agents")
}

/// Event Engine (PRD Module 2) — append-only source of truth. The
/// Conversation Brain and Workflow state above are a materialized view
/// that can, in principle, be rebuilt by replaying these in order
/// (Non-Negotiable 14.5 / 14.6).
model Event {
  id             String   @id @default(cuid())
  conversationId String?  @map("conversation_id")
  type           String
  payload        Json?
  createdAt      DateTime @default(now()) @map("created_at")

  conversation Conversation? @relation(fields: [conversationId], references: [id], onDelete: SetNull)

  @@map("events")
}
